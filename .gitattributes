# Normalisation des fins de ligne
# - text=auto : Git detecte automatiquement si le fichier est binaire ou texte
# - eol=lf    : Pour les fichiers textes, force LF (Unix) dans le repo
# Cela evite que les commits depuis Windows injectent des CRLF qui font
# planter le lint prettier sur le runner Linux du CI.

# Fichiers texte : force LF
*               text=auto eol=lf

# Fichiers Windows специфиques (si on en a) : garder CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Fichiers binaires : pas de conversion
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.docx          binary
*.xlsx          binary
