}

model Contribuable {
  id                           String                         @id @default(dbgenerated("(uuid())")) @db.Char(36)
  raisonSociale                String                         @map("raison_sociale") @db.VarChar(200)
  nif                          String                         @unique(map: "nif") @db.VarChar(20)
  rccm                         String?                        @db.VarChar(30)
  typeContribuableCode         String                         @map("type_contribuable_code") @db.VarChar(50)
  statutFiscalCode             String                         @default("inconnu") @map("statut_fiscal_code") @db.VarChar(50)
  secteur                      String?                        @db.VarChar(100)
  region                       String?                        @db.VarChar(100)
  emailContact                 String?                        @map("email_contact") @db.VarChar(200)
  telephone                    String?                        @db.VarChar(20)
  adresse                      String?                        @db.Text
  accordSiegeId                String?                        @map("accord_siege_id") @db.Char(36)
  userId                       String?                        @unique(map: "user_id") @map("user_id") @db.Char(36)
  // Complétude du profil (Lot 1 — feature creation de compte contribuable)
  profilCompletude             Int                            @default(0) @map("profil_completude")
  profilLocked                 Boolean                        @default(false) @map("profil_locked")
  derniereMajCompletude        DateTime?                      @map("derniere_maj_completude")
  createdAt                    DateTime                       @default(now()) @map("created_at")
  updatedAt                    DateTime                       @default(now()) @map("updated_at")
  actes                        Acte[]
  agrementContribuables        AgrementContribuable[]
  agrements                    Agrement[]
  contribuableHistoriqueFiscal ContribuableHistoriqueFiscal[]
  accordsSiege                 AccordSiege?                   @relation(fields: [accordSiegeId], references: [id], onUpdate: NoAction, map: "contribuables_ibfk_1")
  refTypesContribuable         RefTypeContribuable            @relation(fields: [typeContribuableCode], references: [code], onUpdate: NoAction, map: "contribuables_ibfk_2")
  refStatutsFiscal             RefStatutFiscal                @relation(fields: [statutFiscalCode], references: [code], onUpdate: NoAction, map: "contribuables_ibfk_3")
  utilisateurs                 Utilisateur?                   @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "contribuables_ibfk_4")
  conventions                  Convention[]
  demandes                     Demande[]
  quotas                       Quota[]
  piecesJointes                PieceJointe[]                  @relation("ContribuablePiecesJointes")

  @@index([accordSiegeId], map: "idx_accord_siege_id")
  @@index([nif], map: "idx_nif")
  @@index([statutFiscalCode], map: "idx_statut_fiscal_code")
  @@index([typeContribuableCode], map: "idx_type_contribuable_code")
  @@fulltext([raisonSociale], map: "ft_contribuables")
  @@map("contribuables")
