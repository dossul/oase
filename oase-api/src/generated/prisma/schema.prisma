// ====================================================================
// OASE - Lot 1 : creation de compte contribuable
// Verification du telephone par OTP SMS (signup, futur import DGI, reset pwd)
// Le code OTP n'est JAMAIS stocke en clair : hash SHA-256(code+sel).
// On conserve 1 OTP actif max par couple (telephone, contexte).
// ====================================================================
model PhoneOtpCode {
  id          String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  telephone   String   @db.VarChar(20)
  contexte    String   @db.VarChar(30) // 'SIGNUP' | 'RESET_PWD' | futur 'IMPORT_DGI'
  codeHash    String   @map("code_hash") @db.Char(64)
  sel         String   @db.VarChar(32) // sel aleatoire pour le hash
  payloadJson Json?    @map("payload_json") // {email, passwordHash, ...} selon contexte
  tentatives  Int      @default(0)
  expiresAt   DateTime @map("expires_at") @db.DateTime(3)
  estUtilise  Boolean  @default(false) @map("est_utilise")
  ipOrigine   String?  @map("ip_origine") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([telephone, contexte, estUtilise], map: "idx_phone_otp_actif")
  @@index([expiresAt], map: "idx_phone_otp_expires")
  @@map("phone_otp_codes")
}

